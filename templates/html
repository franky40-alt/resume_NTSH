<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>電子書｜我的學習歷程</title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='style.css') }}">

    <style>

        body {
            background: #f5f7fa;
            color: #333;
        }

        .page-header {
            text-align: center;
            padding: 70px 20px 40px;
        }

        .page-header h1 {
            font-size: 42px;
            margin-bottom: 15px;
        }

        .page-header p {
            font-size: 18px;
            color: #666;
        }

        .books {
            max-width: 1100px;
            margin: auto;
            padding: 20px 20px 70px;
        }

        .book-card {
            display: flex;
            align-items: center;
            gap: 40px;

            background: white;
            padding: 25px;
            margin-bottom: 35px;

            border-radius: 18px;

            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);

            transition: transform 0.3s, box-shadow 0.3s;
        }

        .book-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
        }

        .book-card:nth-child(even) {
            flex-direction: row-reverse;
        }

        .book-image {
            width: 42%;
            height: 300px;

            object-fit: cover;

            border-radius: 15px;
        }

        .book-content {
            flex: 1;
        }

        .book-date {
            color: #777;
            font-size: 15px;
        }

        .book-content h2 {
            font-size: 28px;
            margin: 10px 0 15px;
        }

        .book-content p {
            font-size: 17px;
            line-height: 1.9;
        }

        .book-tag {
            display: inline-block;

            margin-top: 15px;
            padding: 6px 15px;

            background: #eef2f7;
            border-radius: 20px;

            font-size: 14px;
        }

        .read-button {
            display: inline-block;

            margin-top: 18px;
            padding: 9px 20px;

            background: #333;
            color: white;

            text-decoration: none;

            border-radius: 8px;

            transition: background 0.3s;
        }

        .read-button:hover {
            background: #555;
        }

        .back-button {
            display: block;

            width: fit-content;

            margin: 10px auto 60px;

            padding: 10px 25px;

            background: #333;
            color: white;

            text-decoration: none;

            border-radius: 8px;
        }

        .back-button:hover {
            background: #555;
        }

        footer {
            text-align: center;
            padding: 30px;

            background: #222;
            color: white;
        }


        /* 手機版 */

        @media (max-width: 768px) {

            .book-card,
            .book-card:nth-child(even) {
                flex-direction: column;
            }

            .book-image {
                width: 100%;
                height: 250px;
            }

            .page-header h1 {
                font-size: 34px;
            }

            .book-content h2 {
                font-size: 24px;
            }

        }

    </style>

</head>


